# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend SaaS (server/) ---
# PORT: port de l'API (défaut 3001)
PORT=3001
# Base MySQL / MariaDB : DATABASE_URL ou les 5 variables DB_*
# DATABASE_URL="mysql://utilisateur:motdepasse@localhost:3306/base"
DB_HOST="localhost"
DB_PORT=3306
DB_USER="cpaneluser_gspme"
DB_PASSWORD=""
DB_NAME="cpaneluser_gspme"
# JWT_SECRET: secret de signature des sessions (si absent, généré et conservé en base)
JWT_SECRET=""
# Compte super-admin plateforme créé au premier démarrage (optionnel)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# --- Paiement des abonnements : Chariow (https://chariow.com) ---
# Voir docs/PAIEMENT-CHARIOW.md. Le paiement en ligne s'active dès que CHARIOW_API_KEY et CHARIOW_WEBHOOK_SECRET sont définis.
APP_URL="https://votredomaine.com"
CHARIOW_API_KEY=""
CHARIOW_WEBHOOK_SECRET=""
# Identifiants (prd_...) des 6 produits de type Licence créés dans Chariow
CHARIOW_PRODUCT_ESSENTIEL_MENSUEL=""
CHARIOW_PRODUCT_ESSENTIEL_ANNUEL=""
CHARIOW_PRODUCT_BUSINESS_MENSUEL=""
CHARIOW_PRODUCT_BUSINESS_ANNUEL=""
CHARIOW_PRODUCT_PREMIUM_MENSUEL=""
CHARIOW_PRODUCT_PREMIUM_ANNUEL=""
